# stub (padrão, sem chave) | openai | azure | anthropic | google
LLM_PROVIDER=stub

# Opcional. Se vazio, cada provedor usa um modelo padrão pequeno.
# LLM_MODEL=gpt-4o-mini

# Provedor e modelo por agente. Se vazio, vale LLM_PROVIDER / LLM_MODEL.
# PRODUCT_LLM_PROVIDER=openai
# DESIGN_LLM_PROVIDER=anthropic
# DEV_LLM_PROVIDER=google
# REVIEW_LLM_PROVIDER=azure
# PRODUCT_LLM_MODEL=gpt-4o-mini
# DESIGN_LLM_MODEL=claude-3-5-haiku-latest

# Preencha só no .env local. Este arquivo de exemplo não tem segredo.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# 1 força o modelo determinístico mesmo se houver chave.
FABRICA_OFFLINE=1

# memory | sqlite | postgres
FABRICA_CHECKPOINTER=memory
# FABRICA_CHECKPOINTER_URL=postgresql://fabrica:fabrica@localhost:5432/fabrica

# SQLite local. No compose, aponte para o Postgres.
FABRICA_DATABASE_URL=sqlite:///fabrica.db

# Vazio usa o canal em memória. No compose: redis://redis:6379/0
FABRICA_REDIS_URL=

# memory | pgvector
FABRICA_VECTOR_STORE=memory
FABRICA_EMBEDDINGS=fake
# FABRICA_KNOWLEDGE_DIR=knowledge

# none | console | otlp
OTEL_TRACES_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# text | json
FABRICA_LOG_FORMAT=text

# Tentativas ao conectar banco, checkpointer e Redis na subida. O compose usa 15.
FABRICA_STARTUP_RETRIES=1
FABRICA_STARTUP_DELAY=2

# Opcional, só no modo online, para rastrear no LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=fabrica-agentica
